// Prolorg — data model (AiProlice marketplace).
//
// Big/MVP stage: real user accounts (CLIENT / EXPERT roles), server-side
// sessions, inbox conversations, hire requests with status progression,
// reviews after completed hires, contact-evasion violation logging, and a
// paid-unlock record (payment itself lands later via Stripe).
// ExpertProfile.userId links an approved profile to its owner's account.
//
// Conventions:
// - Every table has a UUID primary key and createdAt.
// - Client/expert roles are enforced in application code.
// - Messages may be flagged by the contact-evasion detection checks;
//   flagged messages are reviewed by admins.
// - ContactUnlock records a paid one-time fee unlocking direct contact
//   sharing for one client-expert Conversation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  EXPERT
  ADMIN
}

enum HireStatus {
  OPEN
  AGREED
  CONFIRMED
  COMPLETED
  CANCELLED
  REQUESTED
  ACCEPTED
  IN_PROGRESS
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  role         Role      @default(CLIENT)
  passwordHash String?
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  expertProfile ExpertProfile?

  clientConversations Conversation[] @relation("ClientConversations")
  expertConversations Conversation[] @relation("ExpertConversations")

  sentMessages    Message[]
  paidUnlocks     ContactUnlock[] @relation("PaidUnlocks")
  sessions        Session[]
  violations      Violation[]
  authoredReviews Review[]
}

// Server-side sessions for user auth (Phase 3 / Big stage). The session
// token lives in an httpOnly cookie; only its SHA-256 hash is stored here.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Contact-evasion violations: every inbox message that trips the detection
// checks is logged here so admins can review repeat offenders and block
// them from /addy.
model Violation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  messageId      String?
  reasons        String   // machine-readable reason codes, comma-separated
  excerpt        String   // first ~200 chars of the offending message
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ExpertProfile {
  id              String   @id @default(uuid())
  userId          String?  @unique // linked in Phase 3 when accounts exist
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug            String   @unique
  name            String
  photoUrl        String?
  headline        String
  bio             String   @db.Text
  specialty       String   // one of the 8 expert categories
  skills          String[]
  hourlyRate      Int?     // USD per hour
  projectRate     Int?     // USD starting project price
  availability    String?  // e.g. "Available now", "1–2 weeks", "Booked until Dec"
  city            String?
  country         String?
  languages       String[]
  yearsExperience Int?
  ratingAvg       Float    @default(0)
  reviewCount     Int      @default(0)
  completedJobs   Int      @default(0)
  likesCount      Int      @default(0) // hearts tapped in /watch
  flagCount       Int      @default(0) // "Flag this pro" member reports (one per browser)
  paymentFlagCount Int     @default(0) // auto-detected payment-detail violations by this pro
  isDeactivated   Boolean  @default(false) // hidden from /experts + /watch while true
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  isSample        Boolean  @default(false)     // seed data, removable
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([specialty, status])
  @@index([status, ratingAvg])
  media ExpertMedia[]
  samples ExpertSample[]
  flagReports FlagReport[]
}

// Flag reports on an AI pro, kept strictly separate by kind:
// - USER: a member flagged the pro from the public view (via the popup that
//   collects their username + details). Threshold FLAG_THRESHOLD.
// - PAYMENT: the pro's own inbox messages tripped payment-detail detection
//   (payment links, wallet addresses, "my paypal"-style phrases). Threshold
//   PAYMENT_FLAG_THRESHOLD (lower — payment violations escalate faster).
// Reaching a threshold only marks the pro "needs your review" in /addy;
// it NEVER auto-deactivates.
model FlagReport {
  id           String        @id @default(uuid())
  expertId     String
  expert       ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  kind         String        // USER | PAYMENT
  reporterName String?       // username of the member who flagged (USER kind)
  reporterId   String?       // signed-in user id, when available
  details      String?       @db.Text // popup details (USER) or message excerpt (PAYMENT)
  reasons      String?       // machine-readable detection codes (PAYMENT kind)
  createdAt    DateTime      @default(now())

  @@index([expertId, createdAt])
}

// Uploaded expert media: profile photo and intro video, stored as binary in
// the database so onboarding uploads survive deploys without extra storage
// services. Served via /api/experts/media/[expertId]/[kind].
model ExpertMedia {
  id        String        @id @default(uuid())
  expertId  String
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  kind      String // PHOTO | VIDEO
  mime      String
  data      Bytes
  createdAt DateTime      @default(now())

  @@unique([expertId, kind])
}

// Sample work entries experts attach during onboarding. Title + description +
// optional image only — deliberately no URL field (no external links on
// AiProlice, per the contact lockdown). Served via
// /api/experts/samples/[id]/image.
model ExpertSample {
  id          String        @id @default(uuid())
  expertId    String
  expert      ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  title       String
  description String        @db.Text
  image       Bytes?
  imageMime   String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([expertId, sortOrder])
}

model Conversation {
  id              String   @id @default(uuid())
  clientId        String
  client          User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  expertId        String
  expert          User     @relation("ExpertConversations", fields: [expertId], references: [id], onDelete: Cascade)
  unlockedContact Boolean  @default(false)
  createdAt       DateTime @default(now())

  messages     Message[]
  hireRequests HireRequest[]
  unlocks      ContactUnlock[]

  @@unique([clientId, expertId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  flagged        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model HireRequest {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scope          String
  price          Int
  agreement      String?      @db.Text // plain-language terms both sides accept
  status         HireStatus   @default(REQUESTED)
  createdAt      DateTime     @default(now())

  reviews Review[]
}

model Review {
  id            String      @id @default(uuid())
  hireRequestId String
  hireRequest   HireRequest @relation(fields: [hireRequestId], references: [id], onDelete: Cascade)
  authorId      String? // the client who wrote the review
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@unique([hireRequestId]) // one review per completed hire
}

model ContactUnlock {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  paidById       String
  paidBy         User         @relation("PaidUnlocks", fields: [paidById], references: [id], onDelete: Cascade)
  amountCents    Int
  createdAt      DateTime     @default(now())

  @@unique([conversationId])
}
